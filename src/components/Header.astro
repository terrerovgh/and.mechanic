---
import { Clock3, MapPin, Menu, Phone, X } from 'lucide-astro';
import { siteData } from '../data/siteData';

const nav = [
  { href: '#services', label: 'Services' },
  { href: '#why-us', label: 'Why us' },
  { href: '#reviews', label: 'Reviews' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="relative z-20">
  <div class="bg-ink text-white">
    <div class="container-site flex min-h-10 items-center justify-center gap-x-5 gap-y-1 py-2 text-[11px] font-medium sm:justify-between sm:text-xs">
      <span class="hidden items-center gap-1.5 sm:flex"><MapPin size={14} aria-hidden="true" /> {siteData.address.street}</span>
      <span class="hidden items-center gap-1.5 md:flex"><Clock3 size={14} aria-hidden="true" /> Mon-Fri: 8:00 AM - 5:30 PM</span>
      <a class="focus-ring flex items-center gap-1.5 hover:text-signal" href={`tel:${siteData.phone}`}><Phone size={14} aria-hidden="true" /> {siteData.phoneDisplay}</a>
    </div>
  </div>
  <div class="border-b border-ink/10 bg-cream/95 backdrop-blur">
    <div class="container-site flex h-20 items-center justify-between">
      <a href="#top" class="focus-ring flex items-center leading-none" aria-label={`${siteData.businessName} home`}>
        <img src="/all-needs-mechanic-logo-transparent.png" class="h-16 w-auto" width="96" height="64" alt={siteData.businessName} />
      </a>
      <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary navigation">
        {nav.map((item) => <a class="focus-ring text-sm font-bold text-ink-soft transition hover:text-signal" href={item.href}>{item.label}</a>)}
      </nav>
      <a class="focus-ring hidden rounded-sm bg-signal px-5 py-3 text-sm font-bold text-white transition hover:bg-ink sm:inline-block" href="#contact">Schedule service</a>
      <details class="relative lg:hidden">
        <summary class="focus-ring flex size-11 cursor-pointer list-none items-center justify-center border border-ink/15 text-ink"><Menu size={22} aria-hidden="true" /><span class="sr-only">Open navigation</span></summary>
        <div class="absolute right-0 top-13 w-64 border border-ink/10 bg-cream p-3 shadow-xl">
          <div class="mb-2 flex justify-end"><X size={18} aria-hidden="true" /></div>
          <nav class="flex flex-col" aria-label="Mobile navigation">
            {nav.map((item) => <a class="focus-ring border-t border-ink/10 px-3 py-3 text-sm font-bold" href={item.href}>{item.label}</a>)}
            <a class="mt-3 bg-signal px-3 py-3 text-center text-sm font-bold text-white" href="#contact">Schedule service</a>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>
