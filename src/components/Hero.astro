---
import { ArrowDown, ArrowRight, Phone, ShieldCheck, Zap } from 'lucide-astro';
import { siteData } from '../data/siteData';
---

<section id="top" class="relative overflow-hidden bg-[#dbe7e8] text-ink">
  <div class="absolute inset-0 opacity-25" style="background-image: linear-gradient(115deg, transparent 0 47%, #ff5a1f 47% 48%, transparent 48% 100%), radial-gradient(circle at 80% 45%, #426269 0 2px, transparent 2px); background-size: auto, 28px 28px;"></div>
  <div class="container-site relative grid min-h-[650px] items-center gap-12 py-20 lg:grid-cols-[1.15fr_.85fr] lg:py-24">
    <div class="max-w-3xl">
      <p class="mb-5 flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-ink-soft"><span class="h-px w-8 bg-signal"></span> Your South Georgia auto shop</p>
      <h1 class="display max-w-3xl text-6xl leading-[.84] sm:text-7xl md:text-8xl">Repairs done right.<br /><span class="text-signal">Prices kept honest.</span></h1>
      <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-soft">Dependable diagnostics, maintenance and repair for Ray City drivers. Clear communication, quality work and no surprises.</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a class="focus-ring inline-flex items-center justify-center gap-2 bg-signal px-6 py-4 text-sm font-bold text-white transition hover:bg-ink" href="#contact">Request an estimate <ArrowRight size={18} aria-hidden="true" /></a>
        <a class="focus-ring inline-flex items-center justify-center gap-2 border border-ink/30 px-6 py-4 text-sm font-bold transition hover:border-ink hover:bg-white/40" href="#services">Explore services <ArrowDown size={18} aria-hidden="true" /></a>
      </div>
      <div class="mt-12 flex flex-wrap gap-x-7 gap-y-3 text-sm font-bold text-ink-soft">
        <span class="flex items-center gap-2"><Zap size={17} class="text-signal" aria-hidden="true" /> Fast local service</span>
        <span class="flex items-center gap-2"><ShieldCheck size={17} class="text-signal" aria-hidden="true" /> Work you can trust</span>
      </div>
    </div>
    <div class="relative hidden lg:block">
      <div class="ml-auto max-w-md p-7">
        <img src="/all-needs-mechanic-logo-transparent.png" class="h-auto w-full" width="410" height="259" alt={siteData.businessName} />
      </div>
    </div>
  </div>
  <a class="focus-ring absolute bottom-4 right-5 hidden items-center gap-2 text-xs font-bold uppercase tracking-widest text-ink-soft lg:flex" href={`tel:${siteData.phone}`}><Phone size={15} /> Call {siteData.phoneDisplay}</a>
</section>
