---
import { Phone } from 'lucide-astro';
import { siteData } from '../data/siteData';
---

<a class="focus-ring fixed inset-x-0 bottom-0 z-30 flex items-center justify-center gap-2 bg-signal px-5 py-4 text-sm font-bold text-white shadow-[0_-8px_25px_rgba(16,24,32,.2)] sm:hidden" href={`tel:${siteData.phone}`}><Phone size={18} fill="currentColor" aria-hidden="true" /> Call {siteData.phoneDisplay}</a>
