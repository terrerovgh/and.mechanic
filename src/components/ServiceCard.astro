---
import { CircleDot, ClipboardCheck, Fuel, MoveHorizontal, ScanLine, Settings2, Snowflake } from 'lucide-astro';
import type { Service } from '../data/siteData';

interface Props { service: Service; index: number }
const { service, index } = Astro.props;
const icons = {
  'scan-line': ScanLine,
  'oil-can': Fuel,
  'circle-dot': CircleDot,
  'move-horizontal': MoveHorizontal,
  snowflake: Snowflake,
  'settings-2': Settings2,
  'clipboard-check': ClipboardCheck,
};
const Icon = icons[service.icon];
---

<article class="group relative flex min-h-70 flex-col border border-ink/10 bg-white p-6 transition duration-300 hover:-translate-y-1 hover:border-signal hover:shadow-xl">
  <span class="absolute right-5 top-4 font-display text-5xl font-bold leading-none text-ink/5">0{index + 1}</span>
  <div class="mb-8 flex size-12 items-center justify-center bg-ink text-white transition group-hover:bg-signal"><Icon size={23} strokeWidth={1.8} aria-hidden="true" /></div>
  <h3 class="text-lg font-bold leading-tight text-ink">{service.title}</h3>
  <p class="mt-3 text-sm leading-relaxed text-ink-soft">{service.description}</p>
  <a class="focus-ring mt-auto pt-6 text-xs font-bold uppercase tracking-[.15em] text-signal" href="#contact">Book service <span aria-hidden="true">&#8594;</span></a>
</article>
